<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Luxury Midnight Oceanic Gradient (#031D44 to #04395E) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="315"
                android:startColor="#04395E"
                android:centerColor="#031D44"
                android:endColor="#02132C"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Center Radial Glow behind Logo (#70A288) -->
    <path
        android:pathData="M54,54m-42,0a42,42 0,1,1 84,0a42,42 0,1,1 -84,0"
        android:fillAlpha="0.18">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:startColor="#70A288"
                android:endColor="#0004395E"
                android:type="radial" />
        </aapt:attr>
    </path>

    <!-- Sleek Tech Diagonal Speed Lines in Background (#D5896F) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#25D5896F"
        android:strokeWidth="1.2"
        android:pathData="M-10,30 L90,130 M10,10 L110,110 M30,-10 L130,90" />

    <!-- Subtle Hexagonal Tech Shield Halo (#DAB785) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#30DAB785"
        android:strokeWidth="1.0"
        android:pathData="M54,18 L85,34 L85,74 L54,90 L23,74 L23,34 Z" />
</vector>
