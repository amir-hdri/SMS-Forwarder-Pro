<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Disable cleartext HTTP globally for strict transport security -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Domain configuration for BarPro production API with SHA-256 Certificate Pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.barpro.ir</domain>
        <domain includeSubdomains="true">barpro.ir</domain>
        <!-- SHA-256 SSL Pinning configuration (Placeholder with expiration date for pin rotation) -->
        <pin-set expiration="2027-12-31">
            <!-- Primary Pin: SHA-256 fingerprint of the production leaf/intermediate certificate -->
            <pin digest="SHA-256">AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=</pin>
            <!-- Backup Pin: Secondary pin to prevent outage during certificate rotation -->
            <pin digest="SHA-256">BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=</pin>
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
