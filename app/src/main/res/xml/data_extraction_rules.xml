<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive Room database files from cloud backup -->
        <exclude domain="database" path="sms_forwarder_database" />
        <exclude domain="database" path="sms_forwarder_database-wal" />
        <exclude domain="database" path="sms_forwarder_database-shm" />
        <exclude domain="database" path="." />
        
        <!-- Exclude all shared preferences -->
        <exclude domain="sharedpref" path="." />
        
        <!-- Exclude root databases and shared_prefs directories -->
        <exclude domain="root" path="databases" />
        <exclude domain="root" path="shared_prefs" />
        
        <!-- Exclude internal files and caches -->
        <exclude domain="file" path="." />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive database and credentials from direct device transfers -->
        <exclude domain="database" path="sms_forwarder_database" />
        <exclude domain="database" path="sms_forwarder_database-wal" />
        <exclude domain="database" path="sms_forwarder_database-shm" />
        <exclude domain="database" path="." />
        
        <exclude domain="sharedpref" path="." />
        
        <exclude domain="root" path="databases" />
        <exclude domain="root" path="shared_prefs" />
        
        <exclude domain="file" path="." />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
