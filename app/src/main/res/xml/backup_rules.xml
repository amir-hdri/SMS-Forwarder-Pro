<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive Room database files -->
    <exclude domain="database" path="sms_forwarder_database" />
    <exclude domain="database" path="sms_forwarder_database-wal" />
    <exclude domain="database" path="sms_forwarder_database-shm" />
    
    <!-- Exclude all shared preferences (including EncryptedSharedPreferences master key refs) -->
    <exclude domain="sharedpref" path="." />
    
    <!-- Exclude root databases and shared_prefs directories -->
    <exclude domain="root" path="databases" />
    <exclude domain="root" path="shared_prefs" />
    
    <!-- Exclude internal storage files and caches -->
    <exclude domain="file" path="." />
    <exclude domain="cache" path="." />
</full-backup-content>
